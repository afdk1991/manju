{
  "name": "manju-makers",
  "nodeVersion": "22.11.0",
  "installCommand": "npm install",
  "outputDirectory": "static",
  "cloudFunctions": {
    "mainlandRegions": ["ap-guangzhou"],
    "nodejs": {
      "includeFiles": ["data/**"],
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/v1/home", "destination": "/api/v1/home.json" },
    { "source": "/api/v1/categories", "destination": "/api/v1/categories.json" },
    { "source": "/api/v1/series", "destination": "/api/v1/series.json" },
    { "source": "/api/v1/series/:id", "destination": "/api/v1/series/:id.json" },
    { "source": "/api/v1/series/:id/episodes", "destination": "/api/v1/series/:id/episodes.json" },
    { "source": "/api/v1/episodes/:id", "destination": "/api/v1/episodes/:id.json" },
    { "source": "/api/v1/ota/public-key", "destination": "/api/v1/ota/public-key.json" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/api/v1/*.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    },
    {
      "source": "/files/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
