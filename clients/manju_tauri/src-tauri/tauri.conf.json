{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manju",
  "version": "1.0.0",
  "identifier": "com.manju.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "漫剧 Manju",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "installMode": "passive",
      "installerArgs": [],
      "wixLanguage": ["zh-CN"]
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {}
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.example.com/ota/tauri/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "DuW8zxjUYPNEnNY8RMIe4G670V5ZzX39rl1v9CEVQRU=",
      "windows": {
        "installMode": "passive"
      },
      "macOS": {
        "installMode": "passive"
      },
      "linux": {
        "installMode": "passive"
      },
      "dialog": false,
      "dangerousInsecureTransportProtocol": false
    }
  }
}
