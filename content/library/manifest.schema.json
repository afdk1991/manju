{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manju 漫剧资源 manifest",
  "type": "object",
  "required": ["series_id", "title", "episodes"],
  "properties": {
    "series_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,32}$" },
    "title": { "type": "string" },
    "original_title": { "type": ["string", "null"] },
    "synopsis": { "type": "string" },
    "category_id": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "region": { "type": "string", "default": "CN" },
    "release_year": { "type": "integer" },
    "status": { "enum": ["ongoing", "completed", "upcoming"], "default": "ongoing" },
    "is_vip": { "type": "boolean", "default": false },
    "age_rating": { "type": "string", "default": "all" },
    "cover": { "type": "string", "description": "相对 artifacts 根的路径，如 manju/<id>/cover.webp" },
    "poster": { "type": ["string", "null"] },
    "banner": { "type": ["string", "null"] },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "title"],
        "properties": {
          "index": { "type": "integer" },
          "title": { "type": "string" },
          "thumbnail": { "type": ["string", "null"] },
          "duration_sec": { "type": "integer", "default": 0 },
          "is_free": { "type": "boolean", "default": true },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "quality": { "type": "string", "default": "auto" },
                "url": { "type": "string" },
                "container": { "type": "string", "default": "mp4" },
                "codec": { "type": ["string", "null"] },
                "bitrate_kbps": { "type": ["integer", "null"] },
                "size_bytes": { "type": ["integer", "null"] }
              }
            }
          },
          "subtitles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lang", "url"],
              "properties": {
                "lang": { "type": "string" },
                "label": { "type": "string" },
                "url": { "type": "string" },
                "format": { "type": "string", "default": "vtt" },
                "is_default": { "type": "boolean", "default": false }
              }
            }
          },
          "frames": {
            "type": "array",
            "items": { "type": "string" },
            "description": "图片序列帧路径（可选，滑动漫画模式）"
          }
        }
      }
    }
  }
}
